# MacOS DS_Store files
.DS_Store

# Gradle cache folder
.gradle

# Gradle build folder
build

# IntelliJ
out/
.idea
*.iml
# mpeltonen/sbt-idea plugin
.idea_modules/

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*

# Common working directory
run

# Map generator output (regenerated by tools/map/common/map_generator.py)
tools/map/common/output/
tools/map/chapter2/ch2l1/output/
tools/map/chapter2/ch2l2/output/
__pycache__/

# Block assets preview (regenerated by tools/blocks/common/generate.py)
tools/blocks/common/output/

# Entity model preview (regenerated by tools/entity/common/pale_man.py)
tools/entity/common/output/

# HUD icon preview (tools/gui/common/hud_icons.py)
tools/gui/common/output/

# Claude Code local settings
.claude/

# SoundFonts for the sampled music (fetched by tools/sounds/common/soundfonts/fetch.py; all CC0)
tools/sounds/common/soundfonts/files/
tools/sounds/common/soundfonts/*.sf2
tools/sounds/common/soundfonts/solo_violin/

# Tool previews and scratch output, in each part folder of an area (tools/<area>/<part>/output|out)
tools/*/*/output/
tools/*/*/out/
tools/*/*/*/output/
__pycache__/
