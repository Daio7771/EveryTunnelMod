{
  "multipart": [
    {
      "apply": {
        "model": "every_tunnel:block/duct_core"
      }
    },
    {
      "when": {
        "north": "true"
      },
      "apply": {
        "model": "every_tunnel:block/duct_north"
      }
    },
    {
      "when": {
        "east": "true"
      },
      "apply": {
        "model": "every_tunnel:block/duct_east"
      }
    },
    {
      "when": {
        "south": "true"
      },
      "apply": {
        "model": "every_tunnel:block/duct_south"
      }
    },
    {
      "when": {
        "west": "true"
      },
      "apply": {
        "model": "every_tunnel:block/duct_west"
      }
    },
    {
      "when": {
        "up": "true"
      },
      "apply": {
        "model": "every_tunnel:block/duct_up"
      }
    },
    {
      "when": {
        "down": "true"
      },
      "apply": {
        "model": "every_tunnel:block/duct_down"
      }
    }
  ]
}
