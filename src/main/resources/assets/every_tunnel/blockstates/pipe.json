{
  "multipart": [
    {
      "apply": {
        "model": "every_tunnel:block/pipe_core"
      }
    },
    {
      "when": {
        "north": "true"
      },
      "apply": {
        "model": "every_tunnel:block/pipe_north"
      }
    },
    {
      "when": {
        "east": "true"
      },
      "apply": {
        "model": "every_tunnel:block/pipe_east"
      }
    },
    {
      "when": {
        "south": "true"
      },
      "apply": {
        "model": "every_tunnel:block/pipe_south"
      }
    },
    {
      "when": {
        "west": "true"
      },
      "apply": {
        "model": "every_tunnel:block/pipe_west"
      }
    },
    {
      "when": {
        "up": "true"
      },
      "apply": {
        "model": "every_tunnel:block/pipe_up"
      }
    },
    {
      "when": {
        "down": "true"
      },
      "apply": {
        "model": "every_tunnel:block/pipe_down"
      }
    }
  ]
}
