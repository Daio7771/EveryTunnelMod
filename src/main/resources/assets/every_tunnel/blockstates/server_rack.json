{
  "multipart": [
    {
      "when": {
        "facing": "north"
      },
      "apply": {
        "model": "every_tunnel:block/server_rack_core"
      }
    },
    {
      "when": {
        "facing": "east"
      },
      "apply": {
        "model": "every_tunnel:block/server_rack_core",
        "y": 90
      }
    },
    {
      "when": {
        "facing": "south"
      },
      "apply": {
        "model": "every_tunnel:block/server_rack_core",
        "y": 180
      }
    },
    {
      "when": {
        "facing": "west"
      },
      "apply": {
        "model": "every_tunnel:block/server_rack_core",
        "y": 270
      }
    },
    {
      "when": {
        "facing": "north",
        "down": "false"
      },
      "apply": {
        "model": "every_tunnel:block/server_rack_base"
      }
    },
    {
      "when": {
        "facing": "east",
        "down": "false"
      },
      "apply": {
        "model": "every_tunnel:block/server_rack_base",
        "y": 90
      }
    },
    {
      "when": {
        "facing": "south",
        "down": "false"
      },
      "apply": {
        "model": "every_tunnel:block/server_rack_base",
        "y": 180
      }
    },
    {
      "when": {
        "facing": "west",
        "down": "false"
      },
      "apply": {
        "model": "every_tunnel:block/server_rack_base",
        "y": 270
      }
    }
  ]
}
