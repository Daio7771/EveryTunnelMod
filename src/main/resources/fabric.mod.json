{
  "schemaVersion": 1,
  "id": "every_tunnel",
  "version": "${version}",
  "name": "Every Tunnel",
  "description": "A singleplayer psychological horror experience set in the abandoned Noname Complex. You are the new night-shift security guard. Chapter 1 is complete; the Chapter 2 demo adds a factory and the catacombs below. Music: \"Local Forecast - Elevator\" Kevin MacLeod (incompetech.com), licensed under Creative Commons: By Attribution 4.0 License (creativecommons.org/licenses/by/4.0). Chapter 2's menu theme uses CC0 samples: Old Piano FB (FreePats) and VSCO 2 CE Solo Violin (Versilian Studios, Sam Gossner). See CREDITS.md.",
  "authors": ["Daio7771"],
  "contributors": ["Kevin MacLeod (music: \"Local Forecast - Elevator\", CC BY 4.0)"],
  "contact": {},
  "license": "All-Rights-Reserved",
  "environment": "*",
  "entrypoints": {
    "main": [
      {
        "adapter": "kotlin",
        "value": "daio7771.everytunnel.common.EveryTunnel"
      },
      {
        "adapter": "kotlin",
        "value": "daio7771.everytunnel.chapter1.Chapter1"
      },
      {
        "adapter": "kotlin",
        "value": "daio7771.everytunnel.chapter2.Chapter2"
      }
    ],
    "client": [
      {
        "adapter": "kotlin",
        "value": "daio7771.everytunnel.common.client.EveryTunnelClient"
      },
      {
        "adapter": "kotlin",
        "value": "daio7771.everytunnel.chapter1.client.Chapter1Client"
      },
      {
        "adapter": "kotlin",
        "value": "daio7771.everytunnel.chapter2.Chapter2Client"
      }
    ],
    "fabric-datagen": [
      {
        "adapter": "kotlin",
        "value": "daio7771.everytunnel.common.client.EveryTunnelDataGenerator"
      }
    ],
    "lambdynlights:initializer": [
      {
        "adapter": "kotlin",
        "value": "daio7771.everytunnel.common.client.compat.LambDynamicLightsCompat"
      }
    ],
    "cardinal-components-entity": [
      {
        "adapter": "kotlin",
        "value": "daio7771.everytunnel.common.platform.CardinalProgress"
      },
      {
        "adapter": "kotlin",
        "value": "daio7771.everytunnel.chapter2.platform.Ch2Progress"
      }
    ]
  },
  "custom": {
    "cardinal-components": ["every_tunnel:progress", "every_tunnel:ch2_progress"]
  },
  "mixins": [
    "every_tunnel.mixins.json",
    {
      "config": "every_tunnel.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-language-kotlin": ">=${kotlin_loader_version}",
    "fabric-api": "*",
    "minecraft": "${minecraft_version}",
    "java": ">=17",
    "geckolib": ">=4.8.4",
    "lambdynlights": ">=4.4.0",
    "cardinal-components-base": ">=5.2.3",
    "cardinal-components-entity": ">=5.2.3"
  },
  "recommends": {
    "sound_physics_remastered": "*",
    "sodium": "0.5.x",
    "iris": "1.7.x",
    "indium": "*"
  }
}
