{
  "schemaVersion": 1,
  "id": "every_tunnel",
  "version": "${version}",
  "name": "Every Tunnel",
  "description": "A singleplayer psychological horror experience set in the abandoned Noname Complex. You are the new night-shift security guard. Music: \"Local Forecast - Elevator\" Kevin MacLeod (incompetech.com), licensed under Creative Commons: By Attribution 4.0 License (creativecommons.org/licenses/by/4.0). See CREDITS.md.",
  "authors": ["Daio7771"],
  "contributors": ["Kevin MacLeod (music: \"Local Forecast - Elevator\", CC BY 4.0)"],
  "contact": {},
  "license": "All-Rights-Reserved",
  "environment": "*",
  "entrypoints": {
    "main": [
      {
        "adapter": "kotlin",
        "value": "daio7771.everytunnel.EveryTunnel"
      }
    ],
    "client": [
      {
        "adapter": "kotlin",
        "value": "daio7771.everytunnel.client.EveryTunnelClient"
      }
    ],
    "fabric-datagen": [
      {
        "adapter": "kotlin",
        "value": "daio7771.everytunnel.client.EveryTunnelDataGenerator"
      }
    ],
    "lambdynlights:initializer": [
      {
        "adapter": "kotlin",
        "value": "daio7771.everytunnel.client.compat.LambDynamicLightsCompat"
      }
    ]
  },
  "mixins": [
    "every_tunnel.mixins.json",
    {
      "config": "every_tunnel.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-language-kotlin": ">=${kotlin_loader_version}",
    "fabric-api": "*",
    "minecraft": "${minecraft_version}",
    "java": ">=17",
    "geckolib": ">=4.8.4",
    "lambdynlights": ">=4.4.0"
  },
  "recommends": {
    "sound_physics_remastered": "*",
    "sodium": "0.5.x",
    "iris": "1.7.x",
    "indium": "*"
  }
}
